# --- Blender bridge (MCP server <-> Blender add-on) -------------------------
BLENDER_HOST=127.0.0.1
BLENDER_PORT=8765

# --- MCP server -------------------------------------------------------------
# MCP_TRANSPORT=stdio is the default and is what AI clients expect.
# Use "streamable-http" only for clients that speak HTTP instead of stdio.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000

# --- Timeouts (seconds) -----------------------------------------------------
BLENDER_REQUEST_TIMEOUT=30.0
BLENDER_CONNECT_TIMEOUT=5.0
BLENDER_RENDER_TIMEOUT=600.0

# --- Safety -----------------------------------------------------------------
# blender.execute_python is refused when this is false.
ALLOW_PYTHON_EXECUTION=true

# --- Logging ----------------------------------------------------------------
# Logs always go to stderr: stdout carries the MCP stdio protocol.
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s %(levelname)s %(name)s: %(message)s
